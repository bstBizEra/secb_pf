#!/usr/bin/env bash
# Pre-push budget prevention (SECB-WP-FWK-083).
#
# The budget gate runs in CI, AFTER the push. Three times in one session a revision was
# pushed over its declared budget having been measured in the same command -- 1208/1200,
# 1470/1400, 1871/1800 -- because nothing refused the push. An intention to check is a
# reminder; this is the refusal.
#
# LOCAL_PRE_PUSH_INSTALLED != PORTABLE_ENFORCEMENT
#
# Hooks are NOT copied by `git clone`, so this file is tracked and installed explicitly
# (`scripts/install-hooks.sh`, or `core.hooksPath=hooks`). It is preventive CONVENIENCE.
# CI remains the authoritative shared evidence, because it runs whether or not a
# contributor installed anything -- and it cannot be bypassed with `--no-verify`.
#
# It calls the SAME canonical checker CI calls (`scripts/check_budget.py`). A second
# implementation of "is this within budget" would disagree eventually, and the side that
# refuses would be the weaker one.

set -euo pipefail

BASE="${BUDGET_BASE_REF:-origin/main}"
BODY_FILE="${BUDGET_BODY_FILE:-}"

# Every ref being pushed is checked. A multi-ref push where one ref is over budget must
# fail: passing because another ref was fine is the aggregation error.
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ -n "$BODY_FILE" ] && [ -r "$BODY_FILE" ]; then
    BUDGET_TEXT="$(cat "$BODY_FILE")"
  elif command -v gh >/dev/null 2>&1; then
    BUDGET_TEXT="$(gh pr view --json body --jq .body 2>/dev/null || true)"
  else
    BUDGET_TEXT=""
  fi

  if [ -z "$BUDGET_TEXT" ]; then
    echo "pre-push REFUSED: no budget declaration available for $local_sha." >&2
    echo "  Set BUDGET_BODY_FILE, or make \`gh pr view\` work here." >&2
    echo "  An unreadable declaration is not an absent constraint." >&2
    exit 1
  fi

  # An infrastructure failure is NOT a policy verdict.
  #
  #   origin/main missing  !=  BUDGET_EXCEEDED
  #
  # The first version piped `git diff` straight into the checker, so when the ref was absent
  # the diff failed, the checker saw empty input, and the hook reported "exceeds its declared
  # budget". Measured in CI: a shallow checkout produced exactly that -- a missing ref
  # rendered as a budget violation. The diff is now run and checked SEPARATELY, and an
  # unavailable ref is reported as unavailable.
  if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
    echo "pre-push REFUSED: REQUIRED_REF_UNAVAILABLE -- '$BASE' cannot be resolved." >&2
    echo "  This is an infrastructure fault, not a budget verdict. A shallow clone, a" >&2
    echo "  renamed default branch, or a remote not named 'origin' all land here." >&2
    echo "  Set BUDGET_BASE_REF to a ref that exists; do not read this as within budget." >&2
    exit 1
  fi

  if ! NUMSTAT="$(git diff --numstat "$BASE...$local_sha" 2>&1)"; then
    echo "pre-push REFUSED: DIFF_COMMAND_FAILED against '$BASE'." >&2
    echo "  $NUMSTAT" >&2
    echo "  Reported as a diff failure, NOT as BUDGET_EXCEEDED." >&2
    exit 1
  fi

  if ! printf '%s\n' "$NUMSTAT" \
       | BUDGET_TEXT="$BUDGET_TEXT" python3 scripts/check_budget.py; then
    echo "pre-push REFUSED: BUDGET_EXCEEDED -- $local_sha is over its declared budget" >&2
    echo "  against $BASE. Re-declare the budget in the pull-request body FIRST." >&2
    exit 1
  fi
done

exit 0
