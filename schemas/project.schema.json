{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "secb.project/v1",
  "title": "Project descriptor",
  "description": "The machine-readable project identity the MANDATE_EFFECTIVE gate reads. autonomy_profile records the MEASURED level, never the target: a descriptor that declares an aspiration makes every gate compute against a level the project does not hold. DECLARED_AUTONOMY must equal OBSERVED_AUTONOMY. Canonical serialization: UTF-8 JSON, keys sorted, separators (',',':'), no trailing newline. Digest is sha256 over those bytes, rendered 'sha256:<hex>'. Two spellings of one object must not produce two digests. Backward compatibility: additive optional fields are a minor bump; removing a field, narrowing an enum or making a field required is a MAJOR bump and a new $id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "mandate",
    "classification",
    "prohibited_actions",
    "authority_model"
  ],
  "properties": {
    "schema": {
      "const": "secb.project/v1"
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "product",
        "repository",
        "default_branch"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "mandate": {
      "type": "object",
      "required": [
        "authority_source",
        "expires_at"
      ],
      "properties": {
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "description": "Points at the authority root rather than restating it. Two copies of an expiry date is one copy too many."
    },
    "classification": {
      "type": "object",
      "required": [
        "risk_class",
        "autonomy_profile"
      ],
      "properties": {
        "risk_class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "risk_rationale": {
          "type": "string"
        },
        "autonomy_profile": {
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4",
            "A5",
            "A6"
          ]
        },
        "autonomy_measured_at": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "autonomy_evidence": {
          "type": "object"
        }
      }
    },
    "environments": {
      "type": "object"
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PA-\\d{2}$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "An empty prohibition list is not a permissive project, it is an unclassified one, which is why minItems is 1."
    },
    "budgets": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "authority_model": {
      "type": "object",
      "required": [
        "runtime_identity_grants_authority",
        "producer_may_self_verify"
      ],
      "properties": {
        "runtime_identity_grants_authority": {
          "const": false
        },
        "producer_may_self_verify": {
          "const": false
        },
        "final_verdict_authority": {
          "type": "string"
        }
      },
      "description": "Both fields are const false. They are recorded rather than assumed so that a project claiming otherwise fails validation instead of quietly operating that way. runtime identity != role != capability != authority."
    },
    "status": {
      "type": "object"
    }
  }
}
