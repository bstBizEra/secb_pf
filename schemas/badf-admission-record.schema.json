{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "badf-admission-record/v1",
  "title": "BADF skill admission record",
  "description": "Implements docs/00-governance/BADF_SKILL_ADMISSION_STANDARD.md section 3. Bound to that document at blob b2fcad267a09bc6612ac508272165476daa2c109; re-verify if it changes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "skill_id",
    "name",
    "version",
    "upstream_url",
    "upstream_commit",
    "license",
    "license_decision",
    "owner",
    "purpose",
    "declared_capabilities",
    "data_classes",
    "declared_authority",
    "prohibited_effects",
    "prompt_injection_assessment",
    "supply_chain_assessment",
    "routing_tests",
    "evidence_mapping",
    "rollback",
    "residual_risks",
    "lifecycle_state",
    "assessed_at"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "upstream_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Immutable. Standard 4.1: a moving branch or unpinned release is not acceptable provenance."
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "license_decision": {
      "enum": [
        "COMPATIBLE",
        "INCOMPATIBLE",
        "UNKNOWN"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "declared_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystem",
        "commands",
        "credentials",
        "external_services"
      ],
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Standard 4.4: undeclared capability is denied by default. Empty array means none declared, which denies that class."
    },
    "data_classes": {
      "type": "array",
      "items": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "CONFIDENTIAL",
          "RESTRICTED",
          "SECRET"
        ]
      }
    },
    "declared_authority": {
      "enum": [
        "NONE",
        "READ",
        "WRITE",
        "MUTATE"
      ]
    },
    "prohibited_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_injection_assessment": {
      "type": "object",
      "required": [
        "performed",
        "outcome"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_PERFORMED"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "supply_chain_assessment": {
      "type": "object",
      "required": [
        "performed",
        "outcome"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_PERFORMED"
          ]
        },
        "inspected_files": {
          "type": "integer",
          "minimum": 0
        },
        "total_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "routing_tests": {
      "type": "object",
      "required": [
        "performed",
        "outcome"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_PERFORMED"
          ]
        }
      }
    },
    "evidence_mapping": {
      "type": "object"
    },
    "rollback": {
      "type": "object",
      "required": [
        "strategy",
        "verified"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "ASSESSED",
        "ADMITTED",
        "SANDBOXED",
        "VALIDATED",
        "APPROVED",
        "REGISTERED",
        "ACTIVATED",
        "MONITORED",
        "DEPRECATED",
        "SUPERSEDED",
        "BLOCKED",
        "REJECTED"
      ]
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
