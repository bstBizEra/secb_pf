{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "badf-session-checkpoint/v1",
  "title": "BADF session checkpoint",
  "description": "AGENTS.md-governed crash recovery. A checkpoint that does not name the tree it was taken from cannot be verified on resume, so source_sha and tree_digest are required, not optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "work_package_id",
    "stage",
    "source_sha",
    "tree_digest",
    "authority_ref",
    "budget",
    "completed_steps",
    "pending_steps",
    "evidence_refs",
    "stop_conditions",
    "idempotency_keys",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^SECB-WP-[A-Z0-9]+-[0-9]+$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the authority record. Presence is not validity; resume must re-verify."
    },
    "budget": {
      "type": "object",
      "required": [
        "max_files",
        "max_lines",
        "consumed_lines"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 0
        },
        "max_lines": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_keys": {
      "type": "object",
      "description": "External effect -> key. Resume must not replay an effect whose key is already present."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
