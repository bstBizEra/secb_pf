{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "secb.framework-scope/v1",
  "title": "Frozen framework scope",
  "description": "The scope a stability epoch is measured against. It is FROZEN by version: additions do not silently join it, they raise the version and start a new epoch. Without this, convergence cannot be proven because the target moves. Canonical serialization: UTF-8 JSON, keys sorted, separators (',',':'). Digest is sha256 over those bytes as 'sha256:<hex>'. Backward compatibility: additive optional fields are minor; removing a field, narrowing an enum or adding a required field is MAJOR and takes a new $id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "framework_scope",
    "scope_change_classification",
    "freeze_rule"
  ],
  "properties": {
    "schema": {
      "const": "secb.framework-scope/v1"
    },
    "framework_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "frozen_at",
        "mission",
        "lifecycle_stages",
        "cross_cutting_capabilities",
        "capability_dimensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SECB-SCOPE-\\d{3}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "frozen_at": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The ref the freeze is measured against. A freeze with no ref freezes nothing."
        },
        "frozen_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assign_and_verify_authority",
            "execute_as_super_agent"
          ],
          "properties": {
            "assign_and_verify_authority": {
              "const": true
            },
            "execute_as_super_agent": {
              "const": false
            }
          },
          "description": "Both are const. The mission boundary is not a preference a later revision can quietly invert."
        },
        "lifecycle_stages": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "required",
              "optional",
              "excluded"
            ]
          }
        },
        "cross_cutting_capabilities": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "required",
              "optional",
              "excluded"
            ]
          }
        },
        "capability_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope_change_classification": {
      "type": "object",
      "minProperties": 1
    },
    "freeze_rule": {
      "type": "object"
    }
  }
}
