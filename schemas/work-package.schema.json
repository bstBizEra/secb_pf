{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "secb.work-package/v1",
  "title": "Work package",
  "description": "The unit of authorised work. Every field an executing agent is bounded by is declared here, because a bound that is not written down is not a bound. Canonical serialization: UTF-8 JSON, keys sorted, separators (',',':'), no trailing newline. Digest is sha256 over those bytes, rendered 'sha256:<hex>'. Two spellings of one object must not produce two digests. Backward compatibility: additive optional fields are a minor bump; removing a field, narrowing an enum or making a field required is a MAJOR bump and a new $id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "project_id",
    "objective",
    "stage",
    "scope",
    "risk_class",
    "change_budget",
    "acceptance_criteria",
    "evidence_requirements",
    "autonomous_merge",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "secb.work-package/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^SECB-WP-[A-Z0-9-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "init",
        "product",
        "design",
        "plan",
        "implementation",
        "verification",
        "security",
        "release",
        "production",
        "operations"
      ]
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "repositories",
        "paths"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "class",
          "projection"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "class": {
            "enum": [
              "BYTE_DEPENDENCY",
              "SEMANTIC_DEPENDENCY",
              "ORDERING_DEPENDENCY",
              "AUTHORITY_DEPENDENCY",
              "CONTENT_REUSE_DEPENDENCY",
              "OBSERVATION_DEPENDENCY"
            ]
          },
          "projection": {
            "enum": [
              "EFFECTIVE_MAIN",
              "PROPOSED_HEAD"
            ]
          }
        }
      },
      "description": "A dependency resolved only on PROPOSED_HEAD is resolved nowhere that counts. PROPOSED_HEAD_GREEN != LANDED."
    },
    "risk_class": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "change_budget": {
      "type": "object",
      "required": [
        "max_files",
        "max_lines"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "agent_profile": {
      "type": "string"
    },
    "tool_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "object"
    },
    "autonomous_merge": {
      "type": "boolean"
    },
    "expires_at": {
      "type": "string",
      "minLength": 20
    }
  }
}
